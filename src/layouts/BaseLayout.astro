---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../lib/site';
import { PLANS, yearlyTotal } from '../lib/plans';

interface Props {
  title?: string;
  description?: string;
  /** Pages like 404 should stay out of search results. */
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  url: site.url,
  description: site.description,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Website performance monitoring',
  operatingSystem: 'Web',
  image: ogImage,
  offers: PLANS.flatMap((plan) => [
    {
      '@type': 'Offer',
      name: `${plan.name} (monthly)`,
      price: plan.monthly.toFixed(2),
      priceCurrency: 'USD',
      description: `Up to ${plan.maxSites} sites, billed monthly. 14-day free trial.`,
      url: `${site.url}/#pricing`,
    },
    {
      '@type': 'Offer',
      name: `${plan.name} (yearly)`,
      price: yearlyTotal(plan).toFixed(2),
      priceCurrency: 'USD',
      description: `Up to ${plan.maxSites} sites, billed yearly with 2 months free. 14-day free trial.`,
      url: `${site.url}/#pricing`,
    },
  ]),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <Font cssVariable="--font-instrument-sans" preload />

    <meta name="theme-color" content="#F7F8FA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1116" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Loadline speed report showing LCP, INP and CLS for a client site" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-50 rounded-md bg-ink px-4 py-2 text-sm font-semibold text-canvas"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
