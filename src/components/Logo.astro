---
/**
 * Loadline wordmark, drawn as monoline strokes so it needs no font.
 * The dot of the "i" is the only color: a passing status light.
 */
interface Props {
  class?: string;
}
const { class: className = 'h-[1.375rem] w-auto' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 98 23"
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label="Loadline"
>
  <path d="M1.3 2.5V20" />
  <circle cx="12.3" cy="14" r="6" />
  <circle cx="29.3" cy="14" r="6" />
  <path d="M35.3 8V20" />
  <circle cx="46.3" cy="14" r="6" />
  <path d="M52.3 2.5V20" />
  <path d="M57.3 2.5V20" />
  <path d="M62.3 8V20" />
  <circle cx="62.3" cy="3.2" r="1.75" fill="var(--color-accent)" stroke="none" />
  <path d="M67.3 8V20M67.3 14a6 6 0 0 1 12 0V20" />
  <path d="M84.3 14H96.3A6 6 0 1 0 94.54 18.24" />
</svg>
