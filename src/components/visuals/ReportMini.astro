---
/**
 * A miniature white-label report page. The agency's brand leads; Loadline is absent,
 * which is the point. A second sheet behind it hints at a multi-page PDF.
 */
const tiles = [
  { label: 'LCP', value: '1.9 s', delta: '−2.2 s' },
  { label: 'INP', value: '140 ms', delta: '−180 ms' },
  { label: 'CLS', value: '0.03', delta: '−0.08' },
];
const fixes = [
  { text: 'Compressed hero image on /pricing', impact: 'LCP −2.2 s' },
  { text: 'Deferred the chat widget until first scroll', impact: 'INP −180 ms' },
  { text: 'Reserved space for the promo banner', impact: 'CLS −0.08' },
];
---

<div
  class="relative pt-3 pr-3"
  role="img"
  aria-label="Example white-label monthly report for Brightwater Dental, branded by Northfold Studio. All three Core Web Vitals are good, with three fixes listed for October."
>
  <div class="absolute inset-0 top-0 right-0 bottom-3 left-3 rounded-[var(--radius-card)] border border-line bg-surface" aria-hidden="true"></div>

  <div class="relative rounded-[var(--radius-card)] border border-line bg-surface p-6 shadow-card sm:p-7">
    <div class="flex items-start justify-between gap-4">
      <span class="flex items-center gap-2 text-[0.9375rem] font-bold tracking-[-0.03em]">
        <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M1 15 8 1l7 14H1Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M8 1v14" stroke="currentColor" stroke-width="1.6" />
        </svg>
        Northfold
      </span>
      <span class="text-xs text-muted tnum">Page 1 of 4</span>
    </div>

    <p class="mt-7 text-sm text-muted">Brightwater Dental · brightwaterdental.com</p>
    <p class="mt-1 text-[1.375rem] leading-tight font-semibold tracking-[-0.02em]">October speed report</p>

    <ul class="mt-6 grid grid-cols-3 gap-2">
      {
        tiles.map((t) => (
          <li class="rounded-lg bg-sunken px-2.5 py-3 sm:px-3">
            <span class="flex items-center gap-1.5 text-xs text-muted">
              <span class="size-1.5 rounded-full bg-good" />
              {t.label}
            </span>
            <span class="mt-1 block text-[0.9375rem] leading-tight font-semibold tracking-tight whitespace-nowrap tnum sm:text-lg">
              {t.value}
            </span>
            <span class="text-xs text-good-text tnum">{t.delta}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-sm font-semibold">Fixed this month</p>
    <ul class="mt-2 divide-y divide-line text-sm">
      {
        fixes.map((f) => (
          <li class="flex justify-between gap-4 py-2">
            <span>{f.text}</span>
            <span class="shrink-0 text-muted tnum">{f.impact}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-5 text-xs text-muted">Prepared by Northfold Studio for Brightwater Dental</p>
  </div>
</div>
