---
/**
 * Fictional agency wordmarks. Each gets its own small typographic treatment so the row
 * reads as distinct brands, not six copies of the same label.
 */
---

<section aria-labelledby="proof-title" class="border-y border-line">
  <div class="wrap flex flex-col gap-8 py-10 lg:flex-row lg:items-center lg:gap-12">
    <h2 id="proof-title" class="shrink-0 text-[0.9375rem] font-normal text-muted lg:w-44">
      Trusted by 400+ agencies
    </h2>
    <ul class="grid grid-cols-2 items-center gap-x-8 gap-y-7 text-muted sm:grid-cols-3 lg:flex lg:flex-1 lg:justify-between">
      <li class="flex items-center gap-2 text-[1.0625rem] font-bold tracking-[-0.03em]">
        <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M1 15 8 1l7 14H1Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M8 1v14" stroke="currentColor" stroke-width="1.6" />
        </svg>
        Northfold
      </li>
      <li class="text-[1.0625rem] font-medium tracking-[-0.02em]">
        kestrel<span class="font-normal opacity-70">&amp;</span>vine
      </li>
      <li class="text-[0.9375rem] font-semibold tracking-[0.2em]">OXBOW</li>
      <li class="flex items-center gap-2 text-[1.0625rem] tracking-[-0.02em]">
        <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 1.5a6.5 6.5 0 0 1 0 13Z" fill="currentColor" />
        </svg>
        <span><span class="font-semibold">Halden</span> Studio</span>
      </li>
      <li class="flex items-center gap-1.5 text-[1.0625rem] font-bold tracking-[-0.04em]">
        <span class="inline-grid size-5 place-items-center rounded-[3px] bg-current text-[0.625rem] tracking-normal">
          <span class="text-canvas">Fe</span>
        </span>
        Ferrous
      </li>
      <li class="flex items-center gap-2 text-[1.0625rem] font-medium tracking-[-0.02em]">
        <svg class="h-4 w-3" viewBox="0 0 12 16" aria-hidden="true">
          <path d="M2 2v12M6 5v9M10 8v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        Lumen Row
      </li>
    </ul>
  </div>
</section>
